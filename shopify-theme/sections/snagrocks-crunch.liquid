{%- comment -%}
  Sección interactiva "Elige tu crunch": tarjetas de producto que se expanden al pasar el mouse
  (escritorio) y se deslizan con el dedo (celular). Cada tarjeta lleva a su producto.
{%- endcomment -%}

<div class="sg-crunch color-{{ section.settings.color_scheme }}" style="--sg-pad-top: {{ section.settings.padding_top }}px; --sg-pad-bottom: {{ section.settings.padding_bottom }}px;">
  <div class="sg-crunch__inner page-width">
    {%- if section.settings.kicker != blank -%}
      <p class="sg-crunch__kicker">{{ section.settings.kicker }}</p>
    {%- endif -%}
    {%- if section.settings.heading != blank -%}
      <h2 class="sg-crunch__heading">{{ section.settings.heading }}</h2>
    {%- endif -%}

    <div class="sg-crunch__track" role="list">
      {%- for block in section.blocks -%}
        {%- liquid
          assign p = block.settings.product
          assign link = block.settings.link
          if link == blank and p != blank
            assign link = p.url
          endif
        -%}
        <a
          class="sg-card{% if forloop.first %} is-active{% endif %}"
          href="{{ link | default: '#' }}"
          role="listitem"
          {{ block.shopify_attributes }}
        >
          {%- if block.settings.image -%}
            {{ block.settings.image | image_url: width: 1200 | image_tag: class: 'sg-card__img', loading: 'lazy', widths: '400, 600, 900, 1200', sizes: '(min-width: 750px) 50vw, 80vw', alt: block.settings.title }}
          {%- else -%}
            <div class="sg-card__img sg-card__img--empty"></div>
          {%- endif -%}
          <span class="sg-card__shade"></span>
          <span class="sg-card__body">
            <span class="sg-card__num">{{ forloop.index | prepend: '0' }}</span>
            <span class="sg-card__title">{{ block.settings.title }}</span>
            <span class="sg-card__note">{{ block.settings.note }}</span>
            <span class="sg-card__cta">
              {{ block.settings.cta | default: 'Ver packs' }}
              <svg viewBox="0 0 20 20" width="16" height="16" aria-hidden="true"><path d="M4 10h11M11 5l5 5-5 5" fill="none" stroke="currentColor" stroke-width="2"/></svg>
            </span>
          </span>
        </a>
      {%- endfor -%}
    </div>

    {%- if section.blocks.size > 1 -%}
      <div class="sg-crunch__dots" aria-hidden="true">
        {%- for block in section.blocks -%}
          <span class="sg-dot{% if forloop.first %} is-active{% endif %}"></span>
        {%- endfor -%}
      </div>
    {%- endif -%}
  </div>
</div>

<script>
  (function () {
    var root = document.currentScript.previousElementSibling;
    if (!root) return;
    var cards = root.querySelectorAll('.sg-card');
    var dots = root.querySelectorAll('.sg-dot');
    var track = root.querySelector('.sg-crunch__track');
    function activate(i) {
      cards.forEach(function (c, k) { c.classList.toggle('is-active', k === i); });
      dots.forEach(function (d, k) { d.classList.toggle('is-active', k === i); });
    }
    cards.forEach(function (c, i) {
      c.addEventListener('mouseenter', function () { activate(i); });
      c.addEventListener('focus', function () { activate(i); });
    });
    if (track) {
      track.addEventListener('scroll', function () {
        if (window.innerWidth >= 750) return;
        var w = cards[0] ? cards[0].offsetWidth : 1;
        activate(Math.min(cards.length - 1, Math.round(track.scrollLeft / (w + 12))));
      }, { passive: true });
    }
  })();
</script>

{% stylesheet %}
  .sg-crunch { padding-block: var(--sg-pad-top) var(--sg-pad-bottom); }
  .sg-crunch__kicker { margin: 0 0 4px; font-size: 0.85rem; letter-spacing: 0.12em; text-transform: uppercase; opacity: 0.7; }
  .sg-crunch__heading { margin: 0 0 20px; }
  .sg-crunch__track { display: flex; gap: 12px; height: 560px; }
  .sg-card {
    position: relative; flex: 1 1 0; min-width: 0; overflow: hidden; border-radius: 14px;
    color: #fff; text-decoration: none; isolation: isolate;
    transition: flex-grow 0.6s cubic-bezier(.2,.8,.2,1);
  }
  .sg-card.is-active { flex-grow: 2.6; }
  .sg-card__img { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; transform: scale(1.04); transition: transform 1.2s cubic-bezier(.2,.8,.2,1); z-index: -2; }
  .sg-card__img--empty { background: #d9d4cc; }
  .sg-card.is-active .sg-card__img { transform: scale(1.12); }
  .sg-card__shade { position: absolute; inset: 0; z-index: -1; background: linear-gradient(to top, rgba(0,0,0,.72) 0%, rgba(0,0,0,.15) 45%, rgba(0,0,0,0) 70%); }
  .sg-card__body { position: absolute; left: 0; right: 0; bottom: 0; padding: 22px; display: flex; flex-direction: column; gap: 6px; }
  .sg-card__num { font-size: 0.8rem; letter-spacing: 0.1em; opacity: 0.8; }
  .sg-card__title { font-size: clamp(1.4rem, 2.4vw, 2.2rem); font-weight: 800; line-height: 1.05; text-transform: uppercase; white-space: nowrap; }
  .sg-card__note, .sg-card__cta { max-height: 0; opacity: 0; overflow: hidden; transform: translateY(10px); transition: all 0.5s ease; }
  .sg-card__note { font-size: 1rem; max-width: 32ch; }
  .sg-card__cta { display: inline-flex; align-items: center; gap: 8px; align-self: flex-start; font-weight: 700; font-size: 0.9rem; text-transform: uppercase; letter-spacing: 0.06em; background: #fff; color: #111; border-radius: 999px; padding: 0 16px; }
  .sg-card.is-active .sg-card__note { max-height: 6em; opacity: 1; transform: none; }
  .sg-card.is-active .sg-card__cta { max-height: 3em; padding: 10px 16px; opacity: 1; transform: none; }
  .sg-card:not(.is-active) .sg-card__title { writing-mode: vertical-rl; transform: rotate(180deg); align-self: flex-start; }
  .sg-crunch__dots { display: none; }
  @media (max-width: 749px) {
    .sg-crunch__track { height: auto; overflow-x: auto; scroll-snap-type: x mandatory; scrollbar-width: none; padding-bottom: 4px; }
    .sg-crunch__track::-webkit-scrollbar { display: none; }
    .sg-card, .sg-card.is-active { flex: 0 0 80%; height: 440px; scroll-snap-align: center; }
    .sg-card:not(.is-active) .sg-card__title { writing-mode: horizontal-tb; transform: none; }
    .sg-card .sg-card__note { max-height: 6em; opacity: 1; transform: none; }
    .sg-card .sg-card__cta { max-height: 3em; padding: 10px 16px; opacity: 1; transform: none; }
    .sg-crunch__dots { display: flex; justify-content: center; gap: 6px; margin-top: 12px; }
    .sg-dot { width: 8px; height: 8px; border-radius: 50%; background: currentColor; opacity: 0.25; transition: all .3s; }
    .sg-dot.is-active { opacity: 1; width: 22px; border-radius: 4px; }
  }
  @media (prefers-reduced-motion: reduce) {
    .sg-card, .sg-card__img, .sg-card__note, .sg-card__cta { transition: none; }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Elige tu crunch",
  "tag": "section",
  "class": "section",
  "settings": [
    { "type": "text", "id": "kicker", "label": "Texto pequeño superior", "default": "Del campo colombiano a tu bolsa" },
    { "type": "text", "id": "heading", "label": "Título", "default": "ELIGE TU CRUNCH" },
    { "type": "color_scheme", "id": "color_scheme", "label": "Esquema de color", "default": "scheme-1" },
    { "type": "range", "id": "padding_top", "label": "Espacio arriba", "min": 0, "max": 100, "step": 4, "unit": "px", "default": 48 },
    { "type": "range", "id": "padding_bottom", "label": "Espacio abajo", "min": 0, "max": 100, "step": 4, "unit": "px", "default": 48 }
  ],
  "blocks": [
    {
      "type": "item",
      "name": "Producto",
      "settings": [
        { "type": "image_picker", "id": "image", "label": "Foto" },
        { "type": "text", "id": "title", "label": "Nombre", "default": "Arracacha" },
        { "type": "textarea", "id": "note", "label": "Descripción corta" },
        { "type": "product", "id": "product", "label": "Producto" },
        { "type": "url", "id": "link", "label": "Enlace (opcional, reemplaza al producto)" },
        { "type": "text", "id": "cta", "label": "Texto del botón", "default": "Ver packs" }
      ]
    }
  ],
  "max_blocks": 6,
  "presets": [{ "name": "Elige tu crunch" }]
}
{% endschema %}
